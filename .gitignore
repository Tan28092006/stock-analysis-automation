# The P(win) MR model IS shipped (baked into the Docker image / served on Render) — the
# dashboard's win-probability column is dead without it. All other models stay ignored.
!data/models/win_prob_mr.pkl

# Vietstock login session (auth cookies) - never commit
data/raw/foreign/vietstock_session.json

# Foreign AI-tooling config (not part of this project)
.agents/
.codex-plugin/

# CatBoost training telemetry — rewritten on every ensemble train (perpetual churn)
catboost_info/

