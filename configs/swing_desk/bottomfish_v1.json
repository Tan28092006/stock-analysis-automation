{
  "version": "bottomfish_v1",
  "status": "advisory_filter_unproven",
  "notes": [
    "Design parameters from docs/audits/2026-10-06-bottom-fishing-research.md (sections 5-9), not fitted values.",
    "PNJ 2026 is development data; no threshold was tuned to it.",
    "Changing any value changes bf_params_hash and starts a new bottomfish protocol version.",
    "User decisions 2026-10-06: profiles P1, P2 and P3 enabled; P0 (no bottom-fishing) stays the default; risk per bottom-fish trade 1% NAV on the effective loss (stop + one extra limit-down + costs); held tickers outside VN30 get HOLD/SELL/AVOID only, never BUY (extra_universe empty); BF-B2 anchoring and BF-B3 'cheap' are soft (WARN); missing data, news class or event calendar is BLOCK; P3 always says 'no evidence of edge; measurement only'."
  ],
  "default_profile": "P0",
  "scope": {"new_entries": "vn30", "extra_universe": [], "held_outside_scope": "check_review_only"},
  "limit": {"floor_proxy_pct": -6.5, "band_pct": 7.0, "floor_price_buffer_pct": 1.0, "locked_lookback_sessions": 2,
            "floor_lookback_sessions": 60},
  "classification": {
    "market_idx_ret_5d_pct": -5.0, "market_breadth_max_pct": 40.0,
    "idio_market_max_pct": -8.0, "idio_fundamental_pct": -15.0,
    "beta_window": 60, "beta_min_obs": 40, "beta_gap_sessions": 10, "news_lookback_sessions": 20,
    "fact_min_weight": 0.7, "fact_max_impact": -1,
    "fact_negative_types": ["margin_cut", "warning", "control", "suspension", "fraud", "legal"],
    "unclassified_as": "b"
  },
  "evidence_weights": {"FACT_PRIMARY": 1.0, "FACT_REPORTED": 0.7, "OPINION": 0.3, "RUMOR": 0.0},
  "stabilisation": {"min_sessions_since_floor": 2, "require_higher_low": true, "require_no_new_episode_low": true},
  "events": {"window_sessions": 10,
             "dilution_types": ["egm_capital", "private_placement", "rights_issue", "stock_issue", "restructuring"],
             "other_types": ["ex_rights", "ex_dividend", "earnings", "agm"], "unchecked": "block"},
  "news": {"insider_sell_registration": "warn", "unchecked": "block"},
  "margin": {"lookback_sessions": 20, "unchecked": "block"},
  "liquidity": {"min_avg_value_20_bn": 20.0, "max_order_share_pct": 1.0},
  "regime": {"high_vol_atr_ratio": 2.0, "high_vol_risk_multiplier": 0.5, "atr_median_window": 250,
             "type_c_requires_not_panic": true},
  "budget": {"max_bf_positions": 2, "max_bf_exposure_pct": 15.0, "max_total_open_risk_pct": 4.0},
  "attempts": {"cooldown_sessions_after_bf_loss": 20, "max_new_bf_episodes_per_month": 2},
  "episode": {"lookback_high_sessions": 60, "min_drawdown_pct": -15.0, "reset_recovery_pct": 0.95},
  "costs": {"round_trip_pct": 0.6, "primary_round_trip_pct": 0.4},
  "profiles": {
    "P0": {"allowed_types": [], "label": "Không bắt đáy (mặc định)"},
    "P1": {"allowed_types": ["a", "c"], "type_c_risk_multiplier": 0.5, "risk_pct_nav": 1.0, "risk_pct_nav_max": 1.0,
           "catastrophe_stop_pct": 12.0, "floor_gap_allowance_pct": 7.0, "invalidation": "close_below_panic_low",
           "invalidation_mult": 1.0, "time_stop_sessions": 10, "max_attempts_per_episode": 1, "max_weight_pct": 10.0,
           "entry_limit_mult": 1.005, "exit_signal": "close_above_sma5_or_ema21",
           "label": "Hồi ngắn sau hoảng loạn"},
    "P2": {"allowed_types": ["a"], "risk_pct_nav": 1.0, "catastrophe_stop_pct": 25.0, "floor_gap_allowance_pct": 7.0,
           "invalidation": "close_below_panic_low_x0.95_after_last_tranche", "invalidation_mult": 0.95,
           "time_stop_sessions": 40, "max_tranches": 3, "max_attempts_per_episode": 3, "requires_plan_scalein": true,
           "tranche_must_pass": ["BF-G3", "BF-G4"], "max_weight_pct": 10.0, "entry_limit_mult": 1.005,
           "label": "Tích lũy theo tầng"},
    "P3": {"allowed_types": ["b"], "requires_events_resolved": true, "min_sessions_since_last_fact_negative": 10,
           "risk_pct_nav": 1.0, "assumed_loss_pct": 50.0, "time_review_sessions": 60, "max_attempts_per_episode": 1,
           "max_weight_pct": 10.0, "add_ons": false, "entry_limit_mult": 1.005,
           "label": "Tình huống đặc biệt — không có edge",
           "edge_note": "no evidence of edge; measurement only"}
  },
  "behaviour": {"b2_drawdown_250_pct": -40.0, "b2_reasons": ["cheap", "anchor", "old_high"],
                "b3_drawdown_250_pct": -50.0, "b3_reasons": ["cheap"],
                "b6_paper_loss_pct": -10.0, "b7_size_ratio_after_win": 1.25,
                "b8_reasons": ["forum", "group", "tip", "kol", "news"]},
  "evaluation": {"activity_floor": null, "random_n": 3, "random_min_ret_10d_pct": -10.0, "freeze_deadline_vn": "09:00"}
}
